e2e/.auth/

# supabase local
supabase/.branches/
supabase/.temp/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# OneDrive artifacts
*.tmp
~$*

# gitleaks CI output
*.sarif
gitleaks-report.*

# eval harness outputs (results are reported in docs/STATUS.md, not committed)
eval/results/
