{
  "name": "factory-bridge-global",
  "private": true,
  "version": "0.0.1",
  "description": "Factory Bridge Global \u2014 U.S.-facing B2B sourcing and procurement intelligence platform (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:rls": "pnpm --filter @fbg/supabase test",
    "test:e2e": "echo 'Playwright suite arrives with B-05 (auth flows)' && exit 0",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:db": "pnpm --filter @fbg/supabase test",
    "db:gen-enums": "pnpm --filter @fbg/supabase gen:enums"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
