{
  "name": "@fbg/supabase",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Migrations, seed, enum generator and database tests. Tests run against PGlite (dev-time SQL checks) or a real Postgres when DATABASE_URL is set (CI: local Supabase stack).",
  "scripts": {
    "gen:enums": "tsx scripts/gen-enum-sql.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fbg/domain": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
