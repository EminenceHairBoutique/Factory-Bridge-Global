# Factory Bridge Global — environment template (placeholders only; most names are not read by any app yet —
# the web app reads APP_ENV, DESIGN_PREVIEW, SITE_INDEXING, the public-site inquiry values and the Supabase URL/anon key below)
# Copy to .env.local (git-ignored). NEVER commit real values. Server-only vars must NOT be prefixed NEXT_PUBLIC_.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
APP_ENV=development                      # development | staging | production
DESIGN_PREVIEW=                          # "enabled" opens /design-preview on a NON-production APP_ENV host only
SITE_INDEXING=disabled                   # "enabled" + APP_ENV=production lets search engines index the public site (launch gate: OQ-02, OQ-06)

# --- Supabase (per environment; separate projects for dev/staging/prod) ---
# The web app reads the URL + anon key at request time, on the server only (B-05, ADR-042). While they are unset or
# still these placeholders, /sign-in says sign-in is not configured and every workspace redirects there (fail closed).
# Local: copy API_URL and ANON_KEY from `supabase status`, and set NEXT_PUBLIC_APP_URL to the http origin you serve.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me     # server/worker only; the web app does not read it (e2e fixtures use E2E_SUPABASE_SERVICE_ROLE_KEY, local stack only)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # local only

# --- Worker / queue ---
# The worker's own Postgres connection (it assumes service_role per transaction). Required when APP_ENV is
# staging/production; unset in development = health endpoint only (503, queue "not_configured").
WORKER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # local only
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=8080
JOB_MAX_ATTEMPTS=5
JOB_VISIBILITY_TIMEOUT_SECONDS=120
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=900
JOB_TIMEOUT_SECONDS=300
WORKER_POLL_INTERVAL_MS=1000
WORKER_SHUTDOWN_GRACE_MS=25000
# WORKER_ID=                              # optional; defaults to hostname:pid

# --- AI provider (ADR-007) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me             # server/worker only; per-environment key with spend limit
AI_MODEL_EXTRACTION=set-at-implementation
AI_MODEL_TRANSLATION=set-at-implementation
AI_MONTHLY_BUDGET_USD_DEFAULT=50         # per-org soft cap; hard cap enforced in code

# --- Email (Resend) ---
RESEND_API_KEY=replace-me
EMAIL_FROM=noreply@your-verified-domain.example
RESEND_INBOUND_WEBHOOK_SECRET=replace-me # Phase 2

# --- Public-site sourcing requests (B-31, proposed ADR-040) — server only ---
# disabled (default): the form is shown switched off and the action refuses.
# dry_run: validates end to end, sends and stores nothing; refused on a production APP_ENV.
# resend: one plain-text email per request to INQUIRY_TO_EMAIL via RESEND_API_KEY / EMAIL_FROM (founder-approved
#         sender domain, recipient inbox and privacy notice required first: OQ-02, OQ-06, OQ-16).
# The page is prerendered, so a change here takes effect on the next build/deploy.
INQUIRY_DELIVERY=disabled
INQUIRY_TO_EMAIL=

# --- FX (ADR-010) ---
FX_PROVIDER=frankfurter
FX_PROVIDER_API_KEY=                     # blank for free providers

# --- Uploads / scanning (ADR-009) ---
UPLOAD_MAX_BYTES=26214400                # 25 MB (not read by the worker: its limits are code, apps/worker/src/documents/limits.ts)
UPLOAD_MAX_PDF_PAGES=500

# --- Worker: document scan + parse (B-12 / B-13; ADR-044, ADR-045, proposed ADR-043) ---
# disabled (default): the fbg_documents queue fails closed (dead letter); nothing leaves quarantine.
# enabled: ONLY accepted when APP_ENV=development is set explicitly, NODE_ENV is not production, WORKER_DATABASE_URL
#          and SUPABASE_URL both point at a loopback host, and SUPABASE_SERVICE_ROLE_KEY and SCANNER=clamav are set.
#          Anything else refuses to start (the parser sandbox is process-level isolation only, so uploads are
#          processed only against a stack on this machine). No scanner = no processing; there is no "scan off" mode.
DOCUMENT_PROCESSING=disabled
SUPABASE_URL=http://127.0.0.1:54321      # worker-side project URL (Storage); loopback only while ADR-045's gate stands
SCANNER=clamav                           # clamav is the only implemented scanner (hosted = founder decision, not built)
CLAMAV_HOST=127.0.0.1                    # local: docker run -d -p 127.0.0.1:3310:3310 clamav/clamav:stable
CLAMAV_PORT=3310
SCAN_TIMEOUT_SECONDS=60
PARSE_TIMEOUT_SECONDS=60
PARSER_MAX_HEAP_MB=512

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Billing (Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
